<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Select Game Data Folder"
            android:textColor="@color/gold_accent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_manual_path"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Manual Path"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/gold_accent"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Quick Discover Locations Container -->
    <HorizontalScrollView
        android:id="@+id/scroll_quick_paths"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/container_quick_paths"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <!-- Dynamically populated quick location buttons -->
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Current Path bar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/card_background"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp"
        app:cardCornerRadius="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/btn_folder_up"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_arrow_upward_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/gold_accent"
                android:contentDescription="Parent Folder" />

            <TextView
                android:id="@+id/txt_current_path"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="/storage/emulated/0"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:ellipsize="start"
                android:singleLine="true" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Live Directory Status Banner -->
    <LinearLayout
        android:id="@+id/current_dir_status_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:background="#20333333">

        <ImageView
            android:id="@+id/img_current_dir_status"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_check_circle_24"
            app:tint="@color/text_secondary"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/txt_current_dir_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Navigate into the folder containing Morrowind.esm"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Folder List Recycler View -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_folder_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/card_background">

        <Button
            android:id="@+id/btn_select_current_folder"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="SELECT CURRENT FOLDER"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="@color/gold_accent"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_system_saf_picker"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="System SAF Picker"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_cancel_picker"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Cancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
