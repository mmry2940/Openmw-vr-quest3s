<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_launcher_gradient">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="40dp"
            android:gravity="center_horizontal">

            <!-- Hero Header Section -->
            <ImageView
                android:id="@+id/launcher_hero_icon"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:src="@drawable/ic_morrowind_emblem"
                android:scaleType="centerCrop"
                android:contentDescription="@string/app_name"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/launcher_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OpenMW VR"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/gold_accent"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.03" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="The Elder Scrolls III: Morrowind"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="28dp" />

            <!-- Storage Permission Notice Card (Dynamic) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_storage_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface_card"
                app:strokeColor="@color/status_warning"
                app:strokeWidth="1.5dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_warning_amber_24"
                            app:tint="@color/status_warning"
                            android:contentDescription="Warning" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="Storage Permission Required"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/gold_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Required"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/status_warning" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="OpenMW needs file storage access to locate, stream, and load Morrowind game assets."
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_open_storage_permissions"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:text="Review &amp; Grant Storage Access"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        app:icon="@drawable/ic_shield_check_24"
                        app:iconTint="@color/text_primary"
                        app:backgroundTint="@color/colorPrimary"
                        app:cornerRadius="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Data Files Diagnostic Alert Card (Startup warning when files are missing) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_data_diagnostic_alert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface_card"
                app:strokeColor="@color/status_error"
                app:strokeWidth="1.5dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/diagnostic_alert_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_warning_amber_24"
                            app:tint="@color/status_error"
                            android:contentDescription="Warning" />

                        <TextView
                            android:id="@+id/diagnostic_alert_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="Morrowind Assets Missing"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/gold_accent" />

                        <TextView
                            android:id="@+id/diagnostic_alert_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Incomplete"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/status_error" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/diagnostic_alert_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="The Morrowind 'Data Files' directory is missing required master or archive files."
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_fix_game_data"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="Select Folder"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            app:icon="@drawable/ic_folder_open_24"
                            app:iconTint="@color/text_primary"
                            app:backgroundTint="@color/colorPrimary"
                            app:cornerRadius="10dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_view_diagnostic_report"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="View Details"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            app:icon="@drawable/ic_info_outline_24"
                            app:iconTint="@color/gold_accent"
                            app:backgroundTint="@color/btn_action_surface"
                            app:strokeColor="@color/surface_card_stroke"
                            app:strokeWidth="1dp"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Game Data Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_game_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:cardBackgroundColor="@color/surface_card"
                app:strokeColor="@color/surface_card_stroke"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/game_data_status_icon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_folder_open_24"
                            app:tint="@color/gold_accent"
                            android:contentDescription="Folder" />

                        <TextView
                            android:id="@+id/game_data_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="Game Data Location"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/game_data_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Required"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/status_warning"
                            android:background="@drawable/bg_launcher_gradient"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/game_data_path"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="(not configured - please select folder)"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:maxLines="2"
                        android:ellipsize="middle"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/game_data_diagnostic_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Checking data files..."
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="14dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/select_data_button"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="Select Folder"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            app:icon="@drawable/ic_folder_open_24"
                            app:iconTint="@color/text_primary"
                            app:iconGravity="textStart"
                            app:backgroundTint="@color/btn_action_surface"
                            app:strokeColor="@color/surface_card_stroke"
                            app:strokeWidth="1dp"
                            app:cornerRadius="10dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_diagnose_data"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="6dp"
                            android:text="Diagnose"
                            android:textSize="13sp"
                            android:textColor="@color/gold_accent"
                            app:icon="@drawable/ic_info_outline_24"
                            app:iconTint="@color/gold_accent"
                            app:iconGravity="textStart"
                            app:backgroundTint="@color/btn_action_surface"
                            app:strokeColor="@color/surface_card_stroke"
                            app:strokeWidth="1dp"
                            app:cornerRadius="10dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- VR Height & Eye Calibration Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_vr_calibration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface_card"
                app:strokeColor="@color/surface_card_stroke"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_vr_headset_24"
                            app:tint="@color/gold_accent"
                            android:contentDescription="VR Calibration" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="VR Calibration"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/vr_calibration_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="175 cm • 64 mm"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/gold_accent"
                            android:background="@drawable/bg_launcher_gradient"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/vr_calibration_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Calibrate player standing height, seated mode, and eye separation (IPD)."
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_vr_calibration"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Calibrate VR Height &amp; Eyes"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        app:icon="@drawable/ic_vr_headset_24"
                        app:iconTint="@color/text_primary"
                        app:iconGravity="textStart"
                        app:backgroundTint="@color/btn_action_surface"
                        app:strokeColor="@color/surface_card_stroke"
                        app:strokeWidth="1dp"
                        app:cornerRadius="10dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Secondary Actions Grid / Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/manage_mods_button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Mods"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    app:icon="@drawable/ic_extension_24"
                    app:iconTint="@color/gold_accent"
                    app:iconGravity="textStart"
                    app:backgroundTint="@color/surface_card"
                    app:strokeColor="@color/surface_card_stroke"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/storage_button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:text="Storage"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    app:icon="@drawable/ic_shield_check_24"
                    app:iconTint="@color/gold_accent"
                    app:iconGravity="textStart"
                    app:backgroundTint="@color/surface_card"
                    app:strokeColor="@color/surface_card_stroke"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Settings"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    app:icon="@drawable/ic_settings_24"
                    app:iconTint="@color/gold_accent"
                    app:iconGravity="textStart"
                    app:backgroundTint="@color/surface_card"
                    app:strokeColor="@color/surface_card_stroke"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />

            </LinearLayout>

            <!-- Primary Launch Action -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/launch_game_button"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="Launch Morrowind VR"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:letterSpacing="0.02"
                app:icon="@drawable/ic_play_arrow_24"
                app:iconTint="@color/text_primary"
                app:iconGravity="textStart"
                app:iconSize="24dp"
                app:backgroundTint="@color/colorPrimary"
                app:strokeColor="@color/gold_accent"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:elevation="4dp" />

            <!-- Live Status Feedback Message -->
            <TextView
                android:id="@+id/status_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/gold_accent"
                android:gravity="center"
                android:layout_marginTop="18dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
